# Sample environment file for Slack AI Agent
# Copy this to .env and fill in real values. DO NOT commit real secrets.

# Slack credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_PRIVATE_CHANNEL_ID=C0123456789

# Database (Postgres) connection string
# Example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/database

# Choose LLM provider: openai | google | groq
LLM_PROVIDER=openai

# API keys for LLM providers (only the one in use is required)
OPENAI_API_KEY=your-openai-key
GOOGLE_API_KEY=your-google-key
GROQ_API_KEY=your-groq-key

# Company metadata used in prompts
COMPANY_NAME=Code with Infinity
COMPANY_PRODUCT=Coding Courses

# Application Configuration
PORT=3001
NODE_ENV=development
